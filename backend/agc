#!/usr/bin/env python3
"""Audiogram-driven PipeWire EQ controller for failsafe.audiogram-eq.

Builds headphone/speaker gain curves from clinical thresholds (dB HL) and
applies them through a WirePlumber-managed filter-chain smart sink.
"""
from __future__ import annotations

import argparse
import json
import math
import os
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any

APP = "failsafe.audiogram-eq"
PLUGIN_ROOT = Path(__file__).resolve().parent.parent
BUNDLED_PROFILES = PLUGIN_ROOT / "profiles"

CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
ROOT = CONFIG_HOME / "omarchy" / "audiogram-eq"
STATE_PATH = ROOT / "state.json"
WP_FRAGMENT = CONFIG_HOME / "wireplumber" / "wireplumber.conf.d" / "omarchy-audiogram-eq.conf"

EQ_NODE_NAME = "omarchy.audiogram-eq"
EQ_DESCRIPTION = "Audiogram EQ"
EQ_SMART_NAME = "filter.sink.omarchy-audiogram-eq"
EQ_OUTPUT_NAME = "omarchy_audiogram_eq_output"

# Common audiogram anchors, including 3k/6k when the chart has them.
BAND_FREQS = [250, 500, 1000, 2000, 3000, 4000, 6000, 8000]

HEADPHONE_HINTS = (
    "headphone",
    "headset",
    "earbuds",
    "earbud",
    "airpod",
    "bluetooth",
    "bluez",
    "a2dp",
    "handsfree",
    "hfp",
    "hsp",
)

SPEAKER_HINTS = (
    "speaker",
    "built-in",
    "builtin",
    "analog",
    "hdmi",
    "laptop",
    "internal",
    "alsa_output",
)

# One global half-gain style curve. Speakers vs headphones only change
# which intensity default/slot is used — not a second secret attenuation.
CURVE_RULES = {"scale": 0.5, "cap": 12.0, "knee": 20.0}
DEFAULT_INTENSITY = {
    "headphones": 100,
    "speakers": 50,
}
DEFAULT_PER_EAR = {
    "headphones": True,
    "speakers": False,
}


def clone_default_intensity() -> dict[str, int]:
    return dict(DEFAULT_INTENSITY)


def clone_default_per_ear() -> dict[str, bool]:
    return dict(DEFAULT_PER_EAR)


DEFAULT_STATE: dict[str, Any] = {
    "version": 3,
    "enabled": False,
    "mode": "auto",  # auto | headphones | speakers
    "profileId": "custom",
    "intensityByPreset": {"headphones": 100, "speakers": 50},
    "perEarByPreset": {"headphones": True, "speakers": False},
    "activePreset": "speakers",
}

DEFAULT_DISCLAIMER = (
    "Assistive desktop EQ from published thresholds. Not a hearing aid, "
    "not a medical device, and not a substitute for clinical fitting."
)
USER_PROFILES = ROOT / "profiles"
THRESHOLD_MIN = 0
THRESHOLD_MAX = 120


def clone(value: Any) -> Any:
    return json.loads(json.dumps(value))


def finite(value: Any) -> bool:
    return isinstance(value, (int, float)) and math.isfinite(float(value))


def clamp(value: float, low: float, high: float) -> float:
    return max(low, min(high, value))


def clamp_intensity(value: Any, default: int = 100) -> int:
    if not finite(value):
        return int(default)
    return int(clamp(float(value), 0, 100))


def run(cmd: list[str], timeout: float = 5.0) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        cmd,
        check=False,
        text=True,
        capture_output=True,
        timeout=timeout,
    )


def require_ok(result: subprocess.CompletedProcess[str], label: str) -> None:
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip()
        raise RuntimeError(f"{label} failed: {detail or result.returncode}")


def q(value: Any) -> str:
    return json.dumps(str(value))


def emit(payload: dict[str, Any], as_json: bool) -> int:
    if as_json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        if "error" in payload:
            print(payload["error"], file=sys.stderr)
            return 1
        print(json.dumps(payload, indent=2, sort_keys=True))
    return 1 if "error" in payload else 0


def load_json(path: Path) -> Any:
    return json.loads(path.read_text(encoding="utf-8"))


def atomic_write(path: Path, text: str, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    os.close(fd)
    temp_path = Path(temp_name)
    try:
        temp_path.write_text(text, encoding="utf-8")
        os.chmod(temp_path, mode)
        os.replace(temp_path, path)
    finally:
        if temp_path.exists():
            temp_path.unlink()


def normalize_intensity_map(raw: Any, legacy_intensity: Any = None) -> dict[str, int]:
    out = clone_default_intensity()
    if isinstance(raw, dict):
        for key in ("headphones", "speakers"):
            if key in raw:
                out[key] = clamp_intensity(raw[key], out[key])
        return out
    # No per-preset map yet: use v2 defaults (headphones 100 / speakers 50).
    return out


def normalize_per_ear_map(raw: Any) -> dict[str, bool]:
    out = clone_default_per_ear()
    if isinstance(raw, dict):
        for key in ("headphones", "speakers"):
            if key in raw:
                out[key] = bool(raw[key])
    return out


def safe_state(raw: Any) -> dict[str, Any]:
    state = clone(DEFAULT_STATE)
    if not isinstance(raw, dict):
        return state
    state["enabled"] = bool(raw.get("enabled", False))
    mode = str(raw.get("mode", "auto"))
    if mode not in ("auto", "headphones", "speakers"):
        mode = "auto"
    state["mode"] = mode
    state["profileId"] = str(raw.get("profileId") or "custom")[:64]
    state["intensityByPreset"] = normalize_intensity_map(
        raw.get("intensityByPreset"),
        raw.get("intensity"),
    )
    state["perEarByPreset"] = normalize_per_ear_map(raw.get("perEarByPreset"))
    active = str(raw.get("activePreset", "speakers"))
    if active not in ("headphones", "speakers"):
        active = "speakers"
    state["activePreset"] = active
    state["version"] = 3
    return state


def intensity_for(state: dict[str, Any], preset: str) -> int:
    mapping = state.get("intensityByPreset") or DEFAULT_INTENSITY
    if preset not in ("headphones", "speakers"):
        preset = "speakers"
    return clamp_intensity(mapping.get(preset), DEFAULT_INTENSITY[preset])


def set_intensity_for(state: dict[str, Any], preset: str, value: int) -> None:
    if preset not in ("headphones", "speakers"):
        preset = "speakers"
    mapping = normalize_intensity_map(state.get("intensityByPreset"))
    mapping[preset] = clamp_intensity(value, DEFAULT_INTENSITY[preset])
    state["intensityByPreset"] = mapping


def per_ear_for(state: dict[str, Any], preset: str) -> bool:
    mapping = state.get("perEarByPreset") or DEFAULT_PER_EAR
    if preset not in ("headphones", "speakers"):
        preset = "speakers"
    return bool(mapping.get(preset, DEFAULT_PER_EAR[preset]))


def set_per_ear_for(state: dict[str, Any], preset: str, value: bool) -> None:
    if preset not in ("headphones", "speakers"):
        preset = "speakers"
    mapping = normalize_per_ear_map(state.get("perEarByPreset"))
    mapping[preset] = bool(value)
    state["perEarByPreset"] = mapping


def load_state() -> dict[str, Any]:
    if not STATE_PATH.exists():
        return clone(DEFAULT_STATE)
    try:
        return safe_state(load_json(STATE_PATH))
    except Exception:
        return clone(DEFAULT_STATE)


def save_state(state: dict[str, Any]) -> None:
    atomic_write(STATE_PATH, json.dumps(safe_state(state), indent=2) + "\n")


def profile_paths() -> list[Path]:
    """User profiles first so edits override bundled examples."""
    paths: list[Path] = []
    if USER_PROFILES.is_dir():
        paths.extend(sorted(USER_PROFILES.glob("*.json")))
    if BUNDLED_PROFILES.is_dir():
        paths.extend(sorted(BUNDLED_PROFILES.glob("*.json")))
    return paths


def find_profile_path(profile_id: str) -> Path | None:
    seen: set[str] = set()
    for path in profile_paths():
        try:
            data = load_json(path)
        except Exception:
            continue
        if not isinstance(data, dict):
            continue
        pid = str(data.get("id") or path.stem)
        if pid in seen:
            continue
        seen.add(pid)
        if pid == profile_id or path.stem == profile_id:
            return path
    return None


def load_profile(profile_id: str) -> dict[str, Any]:
    path = find_profile_path(profile_id)
    if path is None:
        raise FileNotFoundError(f"audiogram profile not found: {profile_id}")
    data = load_json(path)
    if not isinstance(data, dict):
        raise RuntimeError(f"invalid audiogram profile: {profile_id}")
    return data


def blank_threshold_map() -> dict[str, dict[str, int]]:
    zeros = {str(hz): 0 for hz in BAND_FREQS}
    return {"left": dict(zeros), "right": dict(zeros)}


def clamp_threshold(value: Any, default: int = 0) -> int:
    if value is None:
        return int(default)
    try:
        number = int(round(float(value)))
    except (TypeError, ValueError):
        return int(default)
    return int(clamp(number, THRESHOLD_MIN, THRESHOLD_MAX))


def normalize_threshold_curve(raw: Any) -> dict[str, int]:
    out = {str(hz): 0 for hz in BAND_FREQS}
    if not isinstance(raw, dict):
        return out
    for hz in BAND_FREQS:
        key = str(hz)
        if key in raw and raw[key] is not None:
            out[key] = clamp_threshold(raw[key], 0)
        elif hz in raw and raw[hz] is not None:
            out[key] = clamp_threshold(raw[hz], 0)
    return out


def editor_thresholds(profile: dict[str, Any]) -> list[dict[str, Any]]:
    thresholds = profile.get("thresholdsDbHl") or {}
    left = thresholds.get("left") if isinstance(thresholds, dict) else {}
    right = thresholds.get("right") if isinstance(thresholds, dict) else {}
    left = left if isinstance(left, dict) else {}
    right = right if isinstance(right, dict) else {}
    rows: list[dict[str, Any]] = []
    for hz in BAND_FREQS:
        key = str(hz)
        left_val = left.get(key, left.get(hz))
        right_val = right.get(key, right.get(hz))
        # Fall back to interpolated clinical value when sparse audiograms omit a band.
        if left_val is None:
            left_val = ear_threshold(profile, "left", hz)
        if right_val is None:
            right_val = ear_threshold(profile, "right", hz)
        rows.append(
            {
                "frequency": hz,
                "left": clamp_threshold(left_val, 0),
                "right": clamp_threshold(right_val, 0),
            }
        )
    return rows


def sanitize_profile_id(value: Any, fallback: str = "custom") -> str:
    text = re.sub(r"[^a-zA-Z0-9._-]+", "-", str(value or "").strip())[:64].strip("-._")
    return text or fallback


def user_profile_path(profile_id: str) -> Path:
    return USER_PROFILES / f"{sanitize_profile_id(profile_id)}.json"


def save_user_profile(profile: dict[str, Any]) -> Path:
    profile_id = sanitize_profile_id(profile.get("id"), "custom")
    profile["id"] = profile_id
    path = user_profile_path(profile_id)
    atomic_write(path, json.dumps(profile, indent=2) + "\n")
    return path


def interpolate_threshold(curve: dict[str, Any], frequency: int) -> float | None:
    points: list[tuple[int, float]] = []
    for key, value in curve.items():
        if value is None:
            continue
        try:
            hz = int(key)
            db = float(value)
        except (TypeError, ValueError):
            continue
        if math.isfinite(db):
            points.append((hz, db))
    if not points:
        return None
    points.sort()
    if frequency <= points[0][0]:
        return points[0][1]
    if frequency >= points[-1][0]:
        return points[-1][1]
    for left, right in zip(points, points[1:]):
        f0, g0 = left
        f1, g1 = right
        if f0 <= frequency <= f1:
            if f0 == f1:
                return g0
            # Interpolate in log-frequency space.
            t = (math.log10(frequency) - math.log10(f0)) / (math.log10(f1) - math.log10(f0))
            return g0 + t * (g1 - g0)
    return points[-1][1]


def ear_threshold(profile: dict[str, Any], ear: str, frequency: int) -> float | None:
    thresholds = profile.get("thresholdsDbHl") or {}
    curve = thresholds.get(ear) or {}
    if not isinstance(curve, dict):
        return None
    return interpolate_threshold(curve, frequency)


def average_threshold(profile: dict[str, Any], frequency: int) -> float | None:
    right = ear_threshold(profile, "right", frequency)
    left = ear_threshold(profile, "left", frequency)
    values = [v for v in (right, left) if v is not None]
    if not values:
        return None
    return sum(values) / len(values)


def prescribe_gain(threshold_db_hl: float, *, scale: float, cap: float, knee: float, intensity: float) -> float:
    """Conservative half-gain style map above a mild-loss knee."""
    excess = max(0.0, float(threshold_db_hl) - float(knee))
    raw = excess * float(scale)
    gain = clamp(raw, 0.0, float(cap))
    gain *= clamp(float(intensity), 0.0, 100.0) / 100.0
    return round(gain, 2)


def band_type(index: int) -> str:
    if index == 0:
        return "low-shelf"
    if index == len(BAND_FREQS) - 1:
        return "high-shelf"
    return "peaking"


def prescribe_bands(profile: dict[str, Any], intensity: int, *, per_ear: bool = False) -> list[dict[str, Any]]:
    rules = CURVE_RULES
    bands: list[dict[str, Any]] = []
    for index, frequency in enumerate(BAND_FREQS):
        left_thr = ear_threshold(profile, "left", frequency)
        right_thr = ear_threshold(profile, "right", frequency)
        avg_thr = average_threshold(profile, frequency)

        def gain_for(threshold: float | None) -> float:
            if threshold is None:
                return 0.0
            return prescribe_gain(
                threshold,
                scale=rules["scale"],
                cap=rules["cap"],
                knee=rules["knee"],
                intensity=intensity,
            )

        left_gain = gain_for(left_thr)
        right_gain = gain_for(right_thr)
        avg_gain = gain_for(avg_thr)
        if not per_ear:
            left_gain = avg_gain
            right_gain = avg_gain
        bands.append(
            {
                "frequency": frequency,
                "gain": round((left_gain + right_gain) / 2.0, 2),
                "leftGain": left_gain,
                "rightGain": right_gain,
                "q": 1.0,
                "type": band_type(index),
                "thresholdDbHl": None if avg_thr is None else round(avg_thr, 2),
                "rightDbHl": None if right_thr is None else round(right_thr, 2),
                "leftDbHl": None if left_thr is None else round(left_thr, 2),
                "perEar": bool(per_ear),
            }
        )
    return bands


def auto_preamp(bands: list[dict[str, Any]]) -> float:
    peaks = []
    for band in bands:
        peaks.append(float(band.get("leftGain", band.get("gain", 0.0))))
        peaks.append(float(band.get("rightGain", band.get("gain", 0.0))))
        peaks.append(float(band.get("gain", 0.0)))
    peak = max(peaks, default=0.0)
    return round(-max(0.0, peak), 2)


def classify_sink(name: str, description: str = "") -> str:
    blob = f"{name} {description}".lower()
    if any(token in blob for token in HEADPHONE_HINTS):
        return "headphones"
    if any(token in blob for token in SPEAKER_HINTS):
        return "speakers"
    # Default to speakers for unknown built-in-ish sinks.
    return "speakers"


def node_by_name(objects: list[dict[str, Any]], name: str) -> dict[str, Any] | None:
    for node in nodes(objects):
        if props(node).get("node.name") == name:
            return node
    return None


def eq_output_target(objects: list[dict[str, Any]]) -> tuple[str, str]:
    """Return (node.name, description) for the hardware sink fed by Audiogram EQ."""
    output = node_by_name(objects, EQ_OUTPUT_NAME)
    if not output:
        return "", ""
    output_id = object_id(output)
    target_ids: list[str] = []
    for item in objects:
        if not str(item.get("type", "")).startswith("PipeWire:Interface:Link"):
            continue
        link = props(item)
        if str(link.get("link.output.node", "")) != output_id:
            continue
        target_ids.append(str(link.get("link.input.node", "")))
    for node in nodes(objects):
        if object_id(node) not in target_ids:
            continue
        p = props(node)
        name = str(p.get("node.name") or "")
        if not name or name.startswith("input.") or "audiogram" in name.lower():
            continue
        return name, str(p.get("node.description") or p.get("media.name") or "")
    return "", ""


def dump_objects() -> list[dict[str, Any]]:
    result = run(["pw-dump"], 8.0)
    require_ok(result, "pw-dump")
    data = json.loads(result.stdout or "[]")
    if not isinstance(data, list):
        raise RuntimeError("pw-dump returned unexpected JSON")
    return data


def props(obj: dict[str, Any]) -> dict[str, Any]:
    info = obj.get("info") or {}
    props_obj = info.get("props") or {}
    return props_obj if isinstance(props_obj, dict) else {}


def object_id(obj: dict[str, Any]) -> str:
    return str(obj.get("id", ""))


def nodes(objects: list[dict[str, Any]]) -> list[dict[str, Any]]:
    return [obj for obj in objects if obj.get("type") == "PipeWire:Interface:Node"]


def eq_node(objects: list[dict[str, Any]]) -> dict[str, Any] | None:
    for node in nodes(objects):
        p = props(node)
        name = str(p.get("node.name") or "")
        if p.get("filter.smart.name") == EQ_SMART_NAME:
            return node
        # WirePlumber may publish the smart sink as input.<node.name>.
        if name == EQ_NODE_NAME or name == f"input.{EQ_NODE_NAME}":
            return node
    return None


def node_info(obj: dict[str, Any]) -> dict[str, Any]:
    info = obj.get("info")
    return info if isinstance(info, dict) else {}


def default_sink_name(objects: list[dict[str, Any]]) -> tuple[str, str]:
    # Prefer metadata default.audio.sink when present.
    for obj in objects:
        if obj.get("type") != "PipeWire:Interface:Metadata":
            continue
        metadata = obj.get("metadata") or []
        if not isinstance(metadata, list):
            continue
        for item in metadata:
            if not isinstance(item, dict):
                continue
            if item.get("key") != "default.audio.sink":
                continue
            value = item.get("value")
            if isinstance(value, str):
                try:
                    parsed = json.loads(value)
                    name = str(parsed.get("name") or "")
                    if name:
                        return name, ""
                except Exception:
                    pass
            elif isinstance(value, dict):
                name = str(value.get("name") or "")
                if name:
                    return name, ""
    # Fallback via pactl.
    result = run(["pactl", "get-default-sink"], 3.0)
    if result.returncode == 0:
        name = (result.stdout or "").strip()
        if name:
            return name, ""
    return "", ""


def sink_description(objects: list[dict[str, Any]], name: str) -> str:
    for node in nodes(objects):
        p = props(node)
        if p.get("node.name") == name:
            return str(p.get("node.description") or p.get("media.name") or "")
    return ""


def resolve_preset(state: dict[str, Any], objects: list[dict[str, Any]] | None = None) -> tuple[str, str, str]:
    """Return (preset, sink_name, sink_description)."""
    objects = objects if objects is not None else dump_objects()
    sink_name, _ = default_sink_name(objects)
    description = sink_description(objects, sink_name) if sink_name else ""

    # When Audiogram EQ is the default sink, classify the hardware it feeds.
    if sink_name in (EQ_NODE_NAME, f"input.{EQ_NODE_NAME}") or "audiogram" in sink_name.lower():
        target_name, target_desc = eq_output_target(objects)
        if target_name:
            sink_name, description = target_name, target_desc

    if state["mode"] in ("headphones", "speakers"):
        return state["mode"], sink_name, description
    detected = classify_sink(sink_name, description)
    return detected, sink_name, description


def graph_nodes(bands: list[dict[str, Any]], preamp: float, enabled: bool) -> str:
    """Dual-mono graph: FL through l_*, FR through r_*."""
    pre = preamp if enabled else 0.0
    lines: list[str] = []
    for ear in ("l", "r"):
        lines.append(
            f'          {{ type = builtin name = {ear}_preamp label = bq_lowshelf '
            f'control = {{ "Freq" = 20.0 "Q" = 1.0 "Gain" = {pre} }} }}'
        )
        for index, band in enumerate(bands):
            label = {"low-shelf": "bq_lowshelf", "high-shelf": "bq_highshelf", "peaking": "bq_peaking"}[band["type"]]
            key = "leftGain" if ear == "l" else "rightGain"
            gain = float(band.get(key, band["gain"])) if enabled else 0.0
            lines.append(
                f'          {{ type = builtin name = {ear}_eq_band_{index} label = {label} '
                f'control = {{ "Freq" = {float(band["frequency"])} "Q" = {float(band["q"])} "Gain" = {gain} }} }}'
            )
    return "\n".join(lines)


def graph_links() -> str:
    links: list[str] = []
    last = len(BAND_FREQS) - 1
    for ear in ("l", "r"):
        links.append(f'            {{ output = "{ear}_preamp:Out" input = "{ear}_eq_band_0:In" }}')
        for index in range(last):
            links.append(
                f'            {{ output = "{ear}_eq_band_{index}:Out" input = "{ear}_eq_band_{index + 1}:In" }}'
            )
    return "\n".join(links)


def wireplumber_fragment(bands: list[dict[str, Any]], preamp: float, enabled: bool) -> str:
    last = len(BAND_FREQS) - 1
    return f'''# Managed by {APP}; do not edit while Audiogram EQ is installed.
# Dual-mono graph: channel 0 (FL) uses l_*, channel 1 (FR) uses r_*.
wireplumber.profiles = {{
  main = {{
    {EQ_SMART_NAME} = required
  }}
}}

wireplumber.components = [
  {{
    name = libpipewire-module-filter-chain, type = pw-module-client
    arguments = {{
      node.name = {q(EQ_NODE_NAME)}
      node.description = {q(EQ_DESCRIPTION)}
      media.name = {q(EQ_DESCRIPTION)}
      filter.graph = {{
        nodes = [
{graph_nodes(bands, preamp, enabled)}
        ]
        links = [
{graph_links()}
        ]
        inputs = [ "l_preamp:In" "r_preamp:In" ]
        outputs = [ "l_eq_band_{last}:Out" "r_eq_band_{last}:Out" ]
      }}
      audio.channels = 2
      audio.position = [ FL FR ]
      capture.props = {{
        media.class = Audio/Sink
        filter.smart = true
        filter.smart.name = {q(EQ_SMART_NAME)}
      }}
      playback.props = {{
        node.name = {q(EQ_OUTPUT_NAME)}
        node.passive = true
        media.role = "DSP"
      }}
    }}
    provides = {EQ_SMART_NAME}
  }}
]
'''


def write_wireplumber_fragment(bands: list[dict[str, Any]], preamp: float, enabled: bool) -> None:
    atomic_write(WP_FRAGMENT, wireplumber_fragment(bands, preamp, enabled))


def remove_wireplumber_fragment() -> None:
    if WP_FRAGMENT.exists():
        WP_FRAGMENT.unlink()


def restart_wireplumber() -> None:
    require_ok(run(["systemctl", "--user", "restart", "wireplumber.service"], 15.0), "restart WirePlumber")


def wait_for_graph(timeout: float = 6.0) -> list[dict[str, Any]]:
    deadline = time.monotonic() + timeout
    last: list[dict[str, Any]] = []
    while time.monotonic() < deadline:
        last = dump_objects()
        if eq_node(last) and dual_chain_ready(last):
            return last
        time.sleep(0.2)
    return last


def control_params(objects: list[dict[str, Any]]) -> dict[tuple[str, int | None, str], dict[str, str]]:
    """Map (ear l|r, band_index|None for preamp, key) -> {node, name}."""
    node = eq_node(objects)
    if not node:
        return {}
    params = node_info(node).get("params", {})
    prop_info = params.get("PropInfo", []) if isinstance(params, dict) else []
    found: dict[tuple[str, int | None, str], dict[str, str]] = {}
    for entry in prop_info if isinstance(prop_info, list) else []:
        if not isinstance(entry, dict):
            continue
        name = str(entry.get("name", ""))
        # Groups: ear, band_index|None, control. Keep the alternation non-capturing
        # except for the band digits so Freq|Q|Gain stays group 3.
        match = re.fullmatch(r"([lr])_(?:eq_band_(\d+)|preamp):(Freq|Q|Gain)", name)
        if not match:
            continue
        ear = match.group(1)
        index = int(match.group(2)) if match.group(2) is not None else None
        found[(ear, index, match.group(3))] = {"node": object_id(node), "name": name}
    return found


def dual_chain_ready(objects: list[dict[str, Any]]) -> bool:
    """True when dual-mono controls exist for the current band count."""
    controls = control_params(objects)
    if ("l", None, "Gain") not in controls or ("r", None, "Gain") not in controls:
        return False
    last = len(BAND_FREQS) - 1
    return ("l", last, "Gain") in controls and ("r", last, "Gain") in controls


def set_control(node_id: str, name: str, value: float) -> None:
    payload = json.dumps({"params": [name, value]}, separators=(",", ":"))
    require_ok(run(["pw-cli", "set-param", node_id, "Props", payload], 1.5), f"set {name}")


def apply_runtime(bands: list[dict[str, Any]], preamp: float, enabled: bool, objects: list[dict[str, Any]] | None = None) -> list[dict[str, Any]]:
    objects = objects if objects is not None else dump_objects()
    if not eq_node(objects):
        raise RuntimeError("audiogram EQ graph is not running")
    controls = control_params(objects)
    needed: list[tuple[str, int | None, str]] = []
    for ear in ("l", "r"):
        needed.extend((ear, None, key) for key in ("Freq", "Q", "Gain"))
        needed.extend((ear, index, key) for index in range(len(BAND_FREQS)) for key in ("Freq", "Q", "Gain"))
    missing = [f"{ear}:{idx}:{key}" for ear, idx, key in needed if (ear, idx, key) not in controls]
    if missing:
        objects = wait_for_graph(3.0)
        controls = control_params(objects)
        missing = [f"{ear}:{idx}:{key}" for ear, idx, key in needed if (ear, idx, key) not in controls]
    if missing:
        raise RuntimeError("filter controls unavailable: " + ", ".join(missing[:12]))

    for ear in ("l", "r"):
        gain_key = "leftGain" if ear == "l" else "rightGain"
        for index, band in enumerate(bands):
            set_control(controls[(ear, index, "Freq")]["node"], controls[(ear, index, "Freq")]["name"], float(band["frequency"]))
            set_control(controls[(ear, index, "Q")]["node"], controls[(ear, index, "Q")]["name"], float(band["q"]))
            gain = float(band.get(gain_key, band["gain"])) if enabled else 0.0
            set_control(controls[(ear, index, "Gain")]["node"], controls[(ear, index, "Gain")]["name"], gain)
        set_control(controls[(ear, None, "Freq")]["node"], controls[(ear, None, "Freq")]["name"], 20.0)
        set_control(controls[(ear, None, "Q")]["node"], controls[(ear, None, "Q")]["name"], 1.0)
        set_control(
            controls[(ear, None, "Gain")]["node"],
            controls[(ear, None, "Gain")]["name"],
            float(preamp) if enabled else 0.0,
        )
    return objects


def ensure_graph(bands: list[dict[str, Any]], preamp: float, enabled: bool) -> list[dict[str, Any]]:
    objects = dump_objects()
    if eq_node(objects) and dual_chain_ready(objects):
        return apply_runtime(bands, preamp, enabled, objects)
    # Create or migrate from the older single-chain fragment.
    write_wireplumber_fragment(bands, preamp, enabled)
    restart_wireplumber()
    objects = wait_for_graph()
    if not eq_node(objects) or not dual_chain_ready(objects):
        raise RuntimeError("WirePlumber did not create the dual-mono audiogram EQ sink")
    return apply_runtime(bands, preamp, enabled, objects)


def set_default_to_eq(objects: list[dict[str, Any]]) -> None:
    node = eq_node(objects)
    if not node:
        raise RuntimeError("EQ sink missing")
    require_ok(run(["wpctl", "set-default", object_id(node)], 3.0), "set default sink to Audiogram EQ")


def build_preview(state: dict[str, Any], objects: list[dict[str, Any]] | None = None) -> dict[str, Any]:
    profile = load_profile(state["profileId"])
    objects = objects if objects is not None else dump_objects()
    preset, sink_name, sink_description = resolve_preset(state, objects)
    intensity = intensity_for(state, preset)
    per_ear = per_ear_for(state, preset)
    bands = prescribe_bands(profile, intensity, per_ear=per_ear)
    preamp = auto_preamp(bands)
    profile_path = find_profile_path(state["profileId"])
    return {
        "ready": True,
        "enabled": state["enabled"],
        "mode": state["mode"],
        "activePreset": preset,
        "intensity": intensity,
        "intensityByPreset": normalize_intensity_map(state.get("intensityByPreset")),
        "perEar": per_ear,
        "perEarByPreset": normalize_per_ear_map(state.get("perEarByPreset")),
        "profileId": state["profileId"],
        "profileLabel": profile.get("label") or state["profileId"],
        "profilePath": str(profile_path) if profile_path else "",
        "profileUserOwned": bool(profile_path and USER_PROFILES in profile_path.parents),
        "thresholds": editor_thresholds(profile),
        "disclaimer": profile.get("disclaimer") or DEFAULT_DISCLAIMER,
        "deviceName": sink_description or sink_name or "No audio output",
        "deviceNode": sink_name,
        "bands": bands,
        "preamp": {"value": preamp, "auto": True},
        "rules": CURVE_RULES,
        "graphPresent": bool(eq_node(objects)),
        "dualChain": dual_chain_ready(objects) if eq_node(objects) else False,
        "fragmentPresent": WP_FRAGMENT.exists(),
    }


def parse_profile_save_payload(raw: str) -> dict[str, Any]:
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"invalid profile JSON: {exc}") from exc
    if not isinstance(data, dict):
        raise RuntimeError("profile payload must be a JSON object")
    return data


def cmd_profile_save(as_json: bool, payload_raw: str) -> int:
    state = load_state()
    try:
        payload = parse_profile_save_payload(payload_raw)
        current_id = sanitize_profile_id(state.get("profileId"), "custom")
        requested_id = sanitize_profile_id(payload.get("id") or current_id, current_id)
        # Prefer keeping the active id; never write into the plugin tree.
        profile_id = requested_id or current_id

        try:
            existing = load_profile(profile_id)
        except FileNotFoundError:
            existing = {
                "id": profile_id,
                "label": "My audiogram",
                "disclaimer": DEFAULT_DISCLAIMER,
                "thresholdsDbHl": blank_threshold_map(),
            }

        label = str(payload.get("label") or existing.get("label") or "My audiogram").strip()[:80]
        if not label:
            label = "My audiogram"

        left_raw = payload.get("left")
        right_raw = payload.get("right")
        if left_raw is None and isinstance(payload.get("thresholdsDbHl"), dict):
            left_raw = (payload["thresholdsDbHl"] or {}).get("left")
            right_raw = (payload["thresholdsDbHl"] or {}).get("right")
        # Also accept the editor row list: [{frequency,left,right}, ...]
        if left_raw is None and isinstance(payload.get("thresholds"), list):
            left_raw, right_raw = {}, {}
            for row in payload["thresholds"]:
                if not isinstance(row, dict):
                    continue
                hz = str(int(row.get("frequency") or 0))
                if hz == "0":
                    continue
                left_raw[hz] = row.get("left")
                right_raw[hz] = row.get("right")

        left = normalize_threshold_curve(left_raw if left_raw is not None else (existing.get("thresholdsDbHl") or {}).get("left"))
        right = normalize_threshold_curve(right_raw if right_raw is not None else (existing.get("thresholdsDbHl") or {}).get("right"))

        profile = clone(existing) if isinstance(existing, dict) else {}
        profile["id"] = profile_id
        profile["label"] = label
        profile["disclaimer"] = str(existing.get("disclaimer") or DEFAULT_DISCLAIMER)
        profile["thresholdsDbHl"] = {"left": left, "right": right}
        path = save_user_profile(profile)

        state["profileId"] = profile_id
        save_state(state)
        # Re-apply live EQ with the new thresholds when compensation is on.
        return cmd_apply(as_json)
    except Exception as exc:
        return emit({"error": str(exc)}, as_json)


def cmd_status(as_json: bool) -> int:
    state = load_state()
    try:
        payload = build_preview(state)
    except Exception as exc:
        return emit({"error": str(exc), "enabled": state["enabled"], "mode": state["mode"]}, as_json)
    return emit(payload, as_json)


def cmd_preview(as_json: bool) -> int:
    return cmd_status(as_json)


def cmd_apply(
    as_json: bool,
    *,
    enable: bool | None = None,
    mode: str | None = None,
    intensity: int | None = None,
    per_ear: bool | None = None,
) -> int:
    state = load_state()
    if enable is not None:
        state["enabled"] = enable
    if mode is not None:
        state["mode"] = mode
    try:
        objects = dump_objects()
        preset, sink_name, sink_description = resolve_preset(state, objects)
        state["activePreset"] = preset
        if intensity is not None:
            set_intensity_for(state, preset, intensity)
        if per_ear is not None:
            set_per_ear_for(state, preset, per_ear)
        profile = load_profile(state["profileId"])
        effective_intensity = intensity_for(state, preset)
        effective_per_ear = per_ear_for(state, preset)
        bands = prescribe_bands(profile, effective_intensity, per_ear=effective_per_ear)
        preamp = auto_preamp(bands)
        if state["enabled"]:
            objects = ensure_graph(bands, preamp, True)
            set_default_to_eq(objects)
        else:
            if eq_node(objects) and dual_chain_ready(objects):
                apply_runtime(bands, preamp, False, objects)
            elif eq_node(objects):
                # Old single-chain still present; migrate flat then leave disabled.
                write_wireplumber_fragment(bands, preamp, False)
                restart_wireplumber()
        save_state(state)
        payload = build_preview(state)
        payload["applied"] = True
        payload["deviceName"] = sink_description or sink_name or payload["deviceName"]
        return emit(payload, as_json)
    except Exception as exc:
        return emit({"error": str(exc)}, as_json)


def cmd_reset(as_json: bool) -> int:
    try:
        remove_wireplumber_fragment()
        if STATE_PATH.exists():
            STATE_PATH.unlink()
        # Restart WirePlumber so the smart sink disappears.
        restart_wireplumber()
        return emit({"reset": True, "enabled": False}, as_json)
    except Exception as exc:
        return emit({"error": str(exc)}, as_json)


def cmd_doctor(as_json: bool) -> int:
    state = load_state()
    info: dict[str, Any] = {
        "statePath": str(STATE_PATH),
        "fragmentPath": str(WP_FRAGMENT),
        "fragmentPresent": WP_FRAGMENT.exists(),
        "state": state,
        "tools": {
            "pw-dump": shutil_which("pw-dump"),
            "pw-cli": shutil_which("pw-cli"),
            "wpctl": shutil_which("wpctl"),
            "pactl": shutil_which("pactl"),
        },
    }
    try:
        objects = dump_objects()
        info["graphPresent"] = bool(eq_node(objects))
        info["preview"] = build_preview(state, objects)
    except Exception as exc:
        info["error"] = str(exc)
    return emit(info, as_json)


def shutil_which(name: str) -> bool:
    from shutil import which

    return which(name) is not None


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="agc", description="Audiogram EQ controller")
    parser.add_argument("--json", action="store_true", help="Machine-readable JSON output")
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("status", help="Show current prescription and graph status")
    sub.add_parser("preview", help="Alias for status")
    sub.add_parser("enable", help="Enable compensation and route audio through it")
    sub.add_parser("disable", help="Bypass compensation (flat gains; graph may remain)")
    sub.add_parser("apply", help="Re-apply current state to the live graph")
    sub.add_parser("reset", help="Remove WirePlumber fragment and state")
    sub.add_parser("doctor", help="Diagnostics")

    mode = sub.add_parser("mode", help="Set mode: auto|headphones|speakers")
    mode.add_argument("value", choices=["auto", "headphones", "speakers"])

    intensity = sub.add_parser("intensity", help="Set intensity percent (0-100) for the active preset")
    intensity.add_argument("value", type=int)

    per_ear = sub.add_parser("per-ear", help="Enable/disable independent left/right EQ for the active preset")
    per_ear.add_argument("value", choices=["on", "off", "toggle"])

    profile_save = sub.add_parser("profile-save", help="Save editable audiogram thresholds for the active profile")
    profile_save.add_argument("payload", help="JSON object with label + left/right threshold maps")

    return parser


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    # Accept `--json` before or after the subcommand.
    as_json = False
    if "--json" in argv:
        as_json = True
        argv = [arg for arg in argv if arg != "--json"]
    parser = build_parser()
    args = parser.parse_args(argv)
    as_json = as_json or bool(args.json)
    command = args.command

    if command in ("status", "preview"):
        return cmd_status(as_json)
    if command == "enable":
        return cmd_apply(as_json, enable=True)
    if command == "disable":
        return cmd_apply(as_json, enable=False)
    if command == "apply":
        return cmd_apply(as_json)
    if command == "mode":
        return cmd_apply(as_json, mode=args.value)
    if command == "intensity":
        return cmd_apply(as_json, intensity=args.value)
    if command == "per-ear":
        state = load_state()
        objects = dump_objects()
        preset, _, _ = resolve_preset(state, objects)
        current = per_ear_for(state, preset)
        if args.value == "on":
            value = True
        elif args.value == "off":
            value = False
        else:
            value = not current
        return cmd_apply(as_json, per_ear=value)
    if command == "profile-save":
        return cmd_profile_save(as_json, args.payload)
    if command == "reset":
        return cmd_reset(as_json)
    if command == "doctor":
        return cmd_doctor(as_json)
    return emit({"error": f"unknown command: {command}"}, as_json)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
